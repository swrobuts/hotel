	column Lead-Time-Bucket =
			SWITCH(TRUE(),
			    FACT_BOOKINGS[lead_time] <= 7, "0–7 Tage",
			    FACT_BOOKINGS[lead_time] <= 30, "8–30 Tage",
			    FACT_BOOKINGS[lead_time] <= 90, "31–90 Tage",
			    "über 90 Tage")
		dataType: string
		lineageTag: b49af994-78fc-51ff-93a3-f1b0e94a7ad5
		summarizeBy: none
		sortByColumn: Lead-Time-Sortierung

		annotation SummarizationSetBy = User

	column Lead-Time-Sortierung =
			SWITCH(TRUE(),
			    FACT_BOOKINGS[lead_time] <= 7, 1,
			    FACT_BOOKINGS[lead_time] <= 30, 2,
			    FACT_BOOKINGS[lead_time] <= 90, 3,
			    4)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 20b7107d-d08c-54ff-865f-8a129e4e95cb
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition FACT_BOOKINGS = m
		mode: import
		source =
				let
				    Quelle = PostgreSQL.Database("supabase.butscher.cloud:5433", "hotel"),
				    Tabelle = Quelle{[Schema="hotel_bi",Item="fact_bookings"]}[Data],
				    Typen = Table.TransformColumnTypes(Tabelle, {{"is_canceled", Int64.Type}, {"is_repeated_guest", Int64.Type}})
				in
				    Typen

	annotation PBI_ResultType = Table

