			RETURN CALCULATE([Anzahl Buchungen], REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j)
		formatString: #,0
		lineageTag: 93ec09e6-b41a-46f7-b9c1-8d8ce6110a59

