table FACT_BOOKINGS
	lineageTag: 6c1b786b-0f4d-5443-bd18-8c35336f7684

	measure 'Anzahl Buchungen' = COUNTROWS(FACT_BOOKINGS)
		formatString: #,0
		lineageTag: 893207ed-2314-5a1c-9a62-931f916a77bc

	measure 'Stornoquote %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_BOOKINGS), FACT_BOOKINGS[is_canceled] = 1),
			    COUNTROWS(FACT_BOOKINGS))
		formatString: 0.0 %
		lineageTag: 4a84c9b7-51f2-586d-bfed-238c5d35f1a7

	measure 'Ø Vorlaufzeit' = AVERAGE(FACT_BOOKINGS[lead_time])
		formatString: #,0.0
		lineageTag: 5ef7013c-c8f2-5de8-a92e-c469648aaafb

	measure 'Ø Aufenthaltsdauer' = AVERAGE(FACT_BOOKINGS[total_nights])
		formatString: #,0.00
		lineageTag: d92b69c9-9e9a-5c33-9065-e59c1d943720

	measure 'Gebuchte Zimmernächte' = SUM(FACT_BOOKINGS[total_nights])
		formatString: #,0
		lineageTag: ce150907-701c-57d6-a4d9-01656bb5026e

	measure 'Ø ADR' = AVERAGE(FACT_BOOKINGS[adr])
		formatString: #,0.00
		lineageTag: fd00c9b3-8c8b-5988-bd1b-78d9d04cb6ea

	measure 'Gebuchter Umsatz' = SUM(FACT_BOOKINGS[revenue])
		formatString: #,0
		lineageTag: ca97abb8-75ed-545c-b36f-468eb4174612

	measure 'Durch Stornierung entgangener Umsatz' = CALCULATE(SUM(FACT_BOOKINGS[revenue]), FACT_BOOKINGS[is_canceled] = 1)
		formatString: #,0
		lineageTag: 8648bcd0-6e9f-56e1-89b4-580f780f35d5

	measure Umsatz = CALCULATE(SUM(FACT_BOOKINGS[revenue]), FACT_BOOKINGS[is_canceled] = 0)
		formatString: #,0
		lineageTag: 3ae15481-f575-5bdf-8faf-a0e2a4754bb9

	measure 'Wiederholungsgast-Anteil %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_BOOKINGS), FACT_BOOKINGS[is_repeated_guest] = 1),
			    COUNTROWS(FACT_BOOKINGS))
		formatString: 0.0 %
		lineageTag: b60ec9f6-b937-55d4-9ab4-acfe2d712ec2

	measure 'Anteil mit Sonderwünschen %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(FACT_BOOKINGS), FACT_BOOKINGS[total_of_special_requests] > 0),
			    COUNTROWS(FACT_BOOKINGS))
		formatString: 0.0 %
		lineageTag: 052e1f92-86c0-5662-9f92-ca2e3f649b25

	measure 'Gebuchter Umsatz nach Stornodatum' =
			CALCULATE(
			    SUM(FACT_BOOKINGS[revenue]),
			    USERELATIONSHIP(FACT_BOOKINGS[reservation_status_date_key], DIM_DATE[date_key]))
		formatString: #,0
		lineageTag: de480ac9-d416-512a-9959-65295e2740f5

	measure 'Ø gebuchter Umsatz je Buchung' = DIVIDE([Gebuchter Umsatz], [Anzahl Buchungen])
		formatString: #,0.00
		lineageTag: d1e8be93-7dde-5d84-86e2-28988eed1543

	measure Bezugsjahr = IF(ISFILTERED(DIM_DATE[year]), MAX(DIM_DATE[year]), 2016)
		formatString: 0
		lineageTag: 783e1ef0-effa-4edf-aadd-65b174143595

	measure Vergleichszeitraum =
			VAR j = [Bezugsjahr]
			VAR mb = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[month]), REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j)
			VAR mv = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[month]), REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j - 1)
			VAR m = INTERSECT(mb, mv)
			VAR mn = MINX(m, DIM_DATE[month])
			VAR mx = MAXX(m, DIM_DATE[month])
			RETURN IF(ISEMPTY(m), BLANK(),
			    IF(mn = mx, FORMAT(DATE(2000, mn, 1), "MMM"), FORMAT(DATE(2000, mn, 1), "MMM") & "–" & FORMAT(DATE(2000, mx, 1), "MMM"))
			    & " " & FORMAT(j - 1, "0"))
		lineageTag: 21dff206-c6a4-4e29-86cb-5b67185fb0f5

	measure 'Umsatz Bezugsjahr' =
			VAR j = [Bezugsjahr]
			RETURN CALCULATE([Umsatz], REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j)
		formatString: #,0
		lineageTag: 5c4a5126-5449-4757-9582-8028e26363cb

	measure 'Umsatz Vergleich Bezugsjahr' =
			VAR j = [Bezugsjahr]
			VAR mb = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[month]), REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j)
			VAR mv = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[month]), REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j - 1)
			VAR m = INTERSECT(mb, mv)
			RETURN CALCULATE([Umsatz], REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j, m)
		formatString: #,0
		lineageTag: 200aebd4-621f-4dee-856c-0ad52d78af74

	measure 'Umsatz Vergleich Vorjahr' =
			VAR j = [Bezugsjahr]
			VAR mb = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[month]), REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j)
			VAR mv = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[month]), REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j - 1)
			VAR m = INTERSECT(mb, mv)
			RETURN CALCULATE([Umsatz], REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = j - 1, m)
		formatString: #,0
		lineageTag: 3e4c644a-82c9-47a3-87f2-d3dc54258281

	measure 'Umsatz Veränderung' =
			VAR a = [Umsatz Vergleich Bezugsjahr]
			VAR v = [Umsatz Vergleich Vorjahr]
			VAR d = DIVIDE(a - v, v)
			RETURN IF(ISBLANK(v), "kein Vorjahr im Datensatz",
			    IF(d >= 0, "+", "−") & FORMAT(ABS(d) * 100, "0.0") & " % zu " & [Vergleichszeitraum])
		lineageTag: fc3c603c-874c-4108-8f96-e9d6a456296d

	measure 'Umsatz Farbe' = IF(ISBLANK([Umsatz Vergleich Vorjahr]) || [Umsatz Vergleich Bezugsjahr] >= [Umsatz Vergleich Vorjahr], "#1E3A8A", "#B23B1E")
		lineageTag: f712ff4c-b48d-4d67-a2ef-bc85171a8bb0

	measure 'Umsatz Titel' = "UMSATZ " & FORMAT([Bezugsjahr], "0")
		lineageTag: db5abc8c-6b1c-40ff-aa63-f3bf3fa943ba

	measure 'Umsatz Aktuell' =
			VAR j = [Bezugsjahr]
			VAR y = MAX(Jahre[Jahr])
			RETURN IF(y = j, CALCULATE([Umsatz], REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = y))
		formatString: #,0
		lineageTag: d49a832b-0636-4ed7-ac31-0de819e20d58

	measure 'Umsatz Vorjahre' =
			VAR j = [Bezugsjahr]
			VAR y = MAX(Jahre[Jahr])
			RETURN IF(y <> j, CALCULATE([Umsatz], REMOVEFILTERS(DIM_DATE), DIM_DATE[year] = y))
		formatString: #,0
		lineageTag: 02ba376b-14ad-4e9d-9490-beb46be71cf3

	measure 'Buchungen Bezugsjahr' =
