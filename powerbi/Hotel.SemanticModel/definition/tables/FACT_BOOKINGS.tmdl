	measure 'Letzter Monat Datum' = MAXX(CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[Monat]), ALLSELECTED()), DIM_DATE[Monat])
		formatString: MMMM yyyy
		lineageTag: ba6baf58-0afd-432c-b92a-5f6935c43ac4

	measure 'Erster Monat Datum' = MINX(CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[Monat]), ALLSELECTED()), DIM_DATE[Monat])
		formatString: MMMM yyyy
		lineageTag: a34080ac-b049-4df9-af70-11c419587c4a

	measure 'Letzter Monat' = IF(MAX(DIM_DATE[Monat]) = [Letzter Monat Datum], [Umsatz])
		formatString: #,0
		lineageTag: 7db5f381-fe93-488a-be66-19c0fe28f215

	measure Saisonpunkte =
			VAR y = MAX(DIM_DATE[year])
			VAR cur = [Umsatz]
			VAR mx = MAXX(CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[Monat]), ALLSELECTED(), DIM_DATE[year] = y), [Umsatz])
			RETURN IF(cur = mx && MAX(DIM_DATE[Monat]) < [Letzter Monat Datum], cur)
		formatString: #,0
		lineageTag: b96b59ec-f710-4252-a6be-744c2ec7b5d8

	measure Zeitraum =
			VAR t = CALCULATETABLE(SUMMARIZE(FACT_BOOKINGS, DIM_DATE[year]), ALLSELECTED())
			VAR mn = MINX(t, DIM_DATE[year])
			VAR mx = MAXX(t, DIM_DATE[year])
			RETURN IF(mn = mx, FORMAT(mn, "0"), FORMAT(mn, "0") & "–" & FORMAT(mx, "0"))
		lineageTag: 5ec2fc64-bfa9-428e-9bf4-e9f32449a1ab

	measure Hotelauswahl = IF(HASONEVALUE(DIM_HOTEL[hotel]), MAX(DIM_HOTEL[hotel]), "beide Hotels")
